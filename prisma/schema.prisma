// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// enum ConsolidationStatus {
//   PENDING
//   APPROVED
//   SHIPMENT_CREATED
//   CANCELLED
// }

model Order {
  id                String   @id @default(cuid())
  shopifyOrderId    String   @unique
  rawData           String
  orderName         String
  totalPrice        Decimal
  currency          String
  customerEmail     String?
  fulfillmentStatus String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EasyEcomOrder {
  id                String   @id @default(cuid())
  externalOrderId   String   @unique
  easyEcomOrderId   String   @unique
  invoiceId         String
  rawData           String
  customerEmail     String
  customerPhone     String
  customerName      String
  shippingAddress   String
  items             String
  status            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([externalOrderId])
  @@index([easyEcomOrderId])
  @@index([customerEmail])
}

model Consolidation {
  id          String              @id @default(cuid())
  status      String              @default("PENDING")
  orderLinks  OrderLink[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  auditLogs   AuditLog[]

  @@index([status])
}

model OrderLink {
  id                   String        @id @default(cuid())
  consolidationId      String
  consolidation        Consolidation @relation(fields: [consolidationId], references: [id])
  shopifyOrderId       String        @unique
  shopifyOrderName     String
  customerId           String
  addressHash          String
  shipments            Shipment[]
  awbSyncs             AWBSync[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([consolidationId])
  @@index([customerId, addressHash])
}

model Shipment {
  id                    String    @id @default(cuid())
  orderLinkId           String
  orderLink             OrderLink @relation(fields: [orderLinkId], references: [id])
  quickshiftShipmentId  String?   @unique
  awb                   String?
  labelUrl              String?
  status                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([orderLinkId])
  @@index([awb])
}

model AWBSync {
  id              String    @id @default(cuid())
  orderLinkId     String
  orderLink       OrderLink @relation(fields: [orderLinkId], references: [id])
  shipmentId      String
  shipment        Shipment  @relation(fields: [shipmentId], references: [id])
  invoiceId       String    @unique
  awb             String
  status          String
  invoiceVerified Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderLinkId])
  @@index([shipmentId])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique
  responseBody String
  createdAt    DateTime @default(now())
}

model Fulfillment {
  id                  String   @id @default(cuid())
  orderId             String
  shipmentId          String
  shopifyFulfillmentId String  @unique
  status              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([orderId, shipmentId])
  @@index([shopifyFulfillmentId])
}

model AuditLog {
  id              String         @id @default(cuid())
  entityType      String
  entityId        String
  action          String
  actor           String
  diff            String?
  createdAt       DateTime       @default(now())
  consolidationId String?
  consolidation   Consolidation? @relation(fields: [consolidationId], references: [id])

  @@index([entityType, entityId])
  @@index([consolidationId])
}
